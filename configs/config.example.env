# DEV ONLY example for `go run ./cmd/server` against a local PostgreSQL.
# Demo credentials admin/admin and seed data; listens on 127.0.0.1 only.
# Never use these values on a reachable server; production uses install.sh.
DATABASE_URL=postgres://onefrog:onefrog@127.0.0.1:5432/onefrog?sslmode=disable
OF_DRIVER=postgres
OF_HTTP_ADDR=127.0.0.1:8080
OF_ADMIN_USER=admin
OF_ADMIN_PASSWORD=admin
OF_SEED=1
OF_WEB_DIR=web/dist

